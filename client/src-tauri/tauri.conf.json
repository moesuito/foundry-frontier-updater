{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Foundry & Frontier Sync",
    "version": "1.0.2"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "windows": [
      {
        "title": "Foundry & Frontier Sync",
        "width": 550,
        "height": 400,
        "resizable": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "app"],
      "identifier": "com.foundryfrontier.sync",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "languages": ["PortugueseBR"],
          "displayLanguageSelector": false
        }
      },
      "longDescription": "Atualizador incremental do modpack Foundry & Frontier. Instala sem privilegios de administrador.",
      "shortDescription": "Atualizador do modpack Foundry & Frontier",
      "copyright": "moesuito"
    }
  }
}
